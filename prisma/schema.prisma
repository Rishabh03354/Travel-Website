generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  bookings  Booking[]
}

model Booking {
  id          String   @id @default(cuid())

  destination String
  price       Int
  date        String
  status      String   @default("Pending")

  name        String?
  email       String?
  phone       String?
  travelers   Int?

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
}